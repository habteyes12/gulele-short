{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gulele-short/storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Every stage reads this file; nothing else carries creative decisions.",
  "type": "object",
  "required": [
    "version",
    "title",
    "language",
    "audience",
    "intent",
    "render",
    "style",
    "characters",
    "models",
    "music",
    "shots",
    "end_card"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "object",
      "required": [
        "native",
        "english"
      ],
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": "string",
          "minLength": 1
        },
        "english": {
          "type": "string",
          "minLength": 1
        },
        "credit": {
          "type": "string"
        }
      }
    },
    "language": {
      "type": "object",
      "required": [
        "narration",
        "subtitles"
      ],
      "additionalProperties": false,
      "properties": {
        "narration": {
          "type": "string",
          "description": "BCP-47 code, e.g. am-ET"
        },
        "subtitles": {
          "type": "string"
        }
      }
    },
    "audience": {
      "type": "string",
      "minLength": 10
    },
    "intent": {
      "type": "string",
      "minLength": 10
    },
    "render": {
      "type": "object",
      "required": [
        "fps",
        "aspects",
        "target_duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30
          ]
        },
        "aspects": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "width",
              "height",
              "sub_font_size",
              "sub_margin_v",
              "sub_wrap_chars"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 160
              },
              "height": {
                "type": "integer",
                "minimum": 160
              },
              "sub_font_size": {
                "type": "integer",
                "minimum": 4
              },
              "sub_margin_v": {
                "type": "integer",
                "minimum": 0
              },
              "sub_wrap_chars": {
                "type": "integer",
                "minimum": 16,
                "maximum": 60
              }
            }
          }
        },
        "target_duration_s": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "narration_lead_s": {
          "type": "number",
          "minimum": 0
        },
        "narration_tail_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "block"
      ],
      "additionalProperties": false,
      "properties": {
        "block": {
          "type": "string",
          "minLength": 10,
          "description": "Appended to every keyframe prompt."
        },
        "negative": {
          "type": "string"
        }
      }
    },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 10
          },
          "reference_prompt": {
            "type": "string"
          },
          "reference_seed": {
            "type": "integer"
          }
        }
      }
    },
    "models": {
      "type": "object",
      "required": [
        "tts",
        "image"
      ],
      "additionalProperties": false,
      "properties": {
        "tts": {
          "type": "object",
          "required": [
            "model",
            "voice",
            "style_prompt"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "voice": {
              "type": "string"
            },
            "style_prompt": {
              "type": "string"
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "description": "Narration lines per TTS call (free tier: 10 requests/day/model). Split at silences."
            }
          }
        },
        "image": {
          "type": "object",
          "required": [
            "model",
            "api_style",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "api_style": {
              "type": "string",
              "enum": [
                "json",
                "multipart"
              ]
            },
            "send_seed": {
              "type": "boolean"
            },
            "use_reference": {
              "type": "boolean"
            },
            "params": {
              "type": "object"
            }
          }
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "caption",
        "chosen"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "bpm": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "duration_s": {
          "type": "number"
        },
        "instrumental": {
          "type": "boolean"
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path to the chosen score, relative to repo root. null = placeholder pad."
        },
        "volume_db": {
          "type": "number"
        },
        "duck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number"
            },
            "ratio": {
              "type": "number"
            },
            "attack_ms": {
              "type": "number"
            },
            "release_ms": {
              "type": "number"
            }
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at_shot",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "at_shot": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "beat",
          "reason",
          "shot_size",
          "characters",
          "image_prompt",
          "motion",
          "seed",
          "narration",
          "subtitle",
          "min_duration_s"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "beat": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "Why this shot exists."
          },
          "shot_size": {
            "type": "string",
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "medium_close_up",
              "close_up",
              "extreme_close_up",
              "insert"
            ]
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_prompt": {
            "type": "string",
            "minLength": 10
          },
          "motion": {
            "type": "string",
            "enum": [
              "push_in",
              "pull_out",
              "pan_left",
              "pan_right",
              "tilt_up",
              "tilt_down",
              "static"
            ]
          },
          "video_prompt": {
            "type": "string",
            "description": "Motion + camera only, for Wan 2.2 image-to-video."
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string",
            "minLength": 1
          },
          "min_duration_s": {
            "type": "number",
            "minimum": 2,
            "maximum": 12
          },
          "notes": {
            "type": "string"
          },
          "audio_source": {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "description": "Use a licensed external recording instead of TTS: cut [start,end] seconds from file. Narration/subtitle must match what is actually spoken.",
            "properties": {
              "file": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "gain_db": {
                "type": "number"
              },
              "segments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": "Several [start,end] pieces joined with a short pause (used when a shot quotes two lines that are far apart)."
              }
            }
          },
          "keyframe_from": {
            "type": "string",
            "pattern": "^(s[0-9]{2}|ref:[a-z_]+)$",
            "description": "Borrow another shot's keyframe (or ref:<character> sheet) instead of generating one, e.g. when the image quota is exhausted. Remove to generate this shot's own image."
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": [
        "lines",
        "duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        }
      }
    },
    "revisions": {
      "type": "array",
      "description": "Storyboard changes caused by audience tests. Mirrors DESIGN.md.",
      "items": {
        "type": "object",
        "required": [
          "date",
          "source",
          "change"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "change": {
            "type": "string"
          }
        }
      }
    },
    "narration_credit": {
      "type": "string",
      "description": "Credit for an external narrator; shown on the end card by the storyboard author."
    },
    "output_name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Prefix for final files (default heritage_short)."
    }
  }
}